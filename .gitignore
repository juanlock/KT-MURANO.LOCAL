/public/js

*/database/snapshots/

/.claude/report

.env
# Production database / SSH access -- per machine, never committed.
/.env.production-db
/.env.production-ssh
/node_modules

# bootstrap/cache: the folder itself is kept (Laravel needs it to exist) via
# bootstrap/cache/.gitignore; its generated files (config.php holds APP_KEY
# and passwords from .env) are never committed.
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

/storage/framework/sessions
/storage/framework/views
/storage/framework/cache
/storage/logs/laravel.log

/KT-TOOLS/apps
/KT-TOOLS/documentation
/KT-TOOLS/VERSION
/KT-TOOLS/database/Older
# Production database backups stay on the machine that made them.
/KT-TOOLS/database/production
/KT-TOOLS/sources
/KT-TOOLS/ZIP
storage/logs/laravel.log
