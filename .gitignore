/public/js
# Backup-program profiles and scratch copies (production logs...) -- this PC only
*.cp2
/KT-TOOLS/Temp
# Sube Prod keeps the previous build next to it on the server
/public/js.prev
/public/js.new
#*/database/snapshots/

/.claude/report

.env
# Production database / SSH access -- per machine, never committed.
/.env.production-db
/.env.production-ssh
/node_modules

# bootstrap/cache: the folder itself is kept (Laravel needs it to exist) via
# bootstrap/cache/.gitignore; its generated files (config.php holds APP_KEY
# and passwords from .env) are never committed.
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

