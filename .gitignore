/public/js
# Backup-program profiles and scratch copies (production logs...) -- this PC only
*.cp2
# Sube Prod keeps the previous build next to it on the server
/public/js.prev
/public/js.new
#*/database/snapshots/

/.claude/report

.env
# Production database / SSH access -- per machine, never committed.
/.env.production-db
/.env.production-ssh
/node_modules

# bootstrap/cache: the folder itself is kept (Laravel needs it to exist) via
# bootstrap/cache/.gitignore; its generated files (config.php holds APP_KEY
# and passwords from .env) are never committed.
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

/storage/framework/sessions
/storage/framework/views
/storage/framework/cache
/storage/logs/*.log

# KT-TOOLS is never in git (user's rule, 2026-11-17): backups, reports, manuals, logos, the companies' material and
# customer files all travel between the PCs through Google Drive (database/scripts/protocol_tools_sync.php, run by
# Wake-up, Pa Llevar and A Dormir). Before that only parts of it were left out (2026-10-27: backups, .env_modelo...).
/KT-TOOLS/

# Never in git (2026-10-27, history rewritten and the repository recreated): environment files,
# database dumps / backups (they live in Google Drive), production logs, customer documents.
/.env
/database/dev_sync/
/database/snapshots/
/storage/app.zip
/storage/app/public/backup/
*.sql
*.sql.gz
# The companies' files are not in git (2026-10-27): production owns them; they travel with
# murano:from-prod / protocol_prod_push and are copied to Google Drive by Pa Llevar.
/public/files/
storage/logs/laravel.log
storage/framework/lsp-9f8cde7a723d956b.php
